# Desenvolvimento local do ai-service, fora do docker compose.
# Fora de PRDAL_AMBIENTE=desenvolvimento o ai-service exige SERVICE_TOKEN com pelo
# menos 32 bytes e esconde /docs, /redoc e /openapi.json.
PRDAL_AMBIENTE=desenvolvimento
SERVICE_TOKEN=
# Claude pela API da Anthropic. Sem AI_MODEL as rotas de IA degradam em
# desenvolvimento e o servico nao sobe fora dele.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=16000
AI_MAX_RETRIES=2
AI_TIMEOUT_PISO_S=5
AI_TIMEOUT_TETO_S=120
OTEL_EXPORTER_OTLP_ENDPOINT=
DOC_SERVICE_URL=http://localhost:8080
CHROMA_HOST=localhost
CHROMA_PORT=8001
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
